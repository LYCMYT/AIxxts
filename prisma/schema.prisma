generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "sqlite"
}

enum UserRole {
  ADMIN
  READER
}

enum SourceType {
  RSS
  OFFICIAL_BLOG
  HACKER_NEWS
  REDDIT
  YOUTUBE
  GITHUB
  X
  DOUYIN
  XIAOHONGSHU
  MANUAL
}

enum CandidateStatus {
  NEW
  DUPLICATE
  SELECTED
  ARCHIVED
  REJECTED
}

enum DigestStatus {
  DRAFT
  PUBLISHED
  FAILED
}

enum JobStatus {
  RUNNING
  SUCCESS
  FAILED
  SKIPPED
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  name         String?
  passwordHash String
  role         UserRole @default(READER)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model Source {
  id                   String          @id @default(cuid())
  name                 String
  type                 SourceType
  url                  String?
  config               Json?
  enabled              Boolean         @default(true)
  fetchIntervalMinutes Int             @default(60)
  lastFetchedAt        DateTime?
  lastError            String?
  createdAt            DateTime        @default(now())
  updatedAt            DateTime        @updatedAt
  items                CandidateItem[]
  jobRuns              JobRun[]

  @@index([enabled, type])
}

model CandidateItem {
  id                String          @id @default(cuid())
  sourceId          String
  source            Source          @relation(fields: [sourceId], references: [id], onDelete: Cascade)
  externalId        String?
  canonicalUrl      String          @unique
  title             String
  summary           String?
  contentText       String?
  translatedTitle   String?
  translatedSummary String?
  translatedContent String?
  translatedAt      DateTime?
  author            String?
  publishedAt       DateTime
  collectedAt       DateTime        @default(now())
  hotScore          Float?
  influenceScore    Float?
  rawEngagement     Json?
  rawPayload        Json?
  status            CandidateStatus @default(NEW)
  duplicateOfId     String?
  duplicateOf       CandidateItem?  @relation("DuplicateItems", fields: [duplicateOfId], references: [id])
  duplicates        CandidateItem[] @relation("DuplicateItems")
  digestItems       DigestItem[]

  @@index([publishedAt])
  @@index([sourceId, publishedAt])
  @@index([status, publishedAt])
}

model DailyDigest {
  id          String       @id @default(cuid())
  digestDate  String       @unique
  status      DigestStatus @default(DRAFT)
  title       String
  summary     String?
  generatedAt DateTime?
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  llmRunId    String?
  llmRun      LlmRun?      @relation(fields: [llmRunId], references: [id])
  items       DigestItem[]
}

model DigestItem {
  id             String        @id @default(cuid())
  digestId       String
  digest         DailyDigest   @relation(fields: [digestId], references: [id], onDelete: Cascade)
  candidateId    String
  candidate      CandidateItem @relation(fields: [candidateId], references: [id])
  rank           Int
  titleSnapshot  String
  sourceSnapshot String
  urlSnapshot    String
  interpretation String
  score          Float?
  signals        Json?
  createdAt      DateTime      @default(now())

  @@unique([digestId, rank])
  @@unique([digestId, candidateId])
}

model LlmRun {
  id           String        @id @default(cuid())
  purpose      String
  provider     String
  model        String
  inputTokens  Int?
  outputTokens Int?
  costCents    Int?
  promptHash   String?
  responseJson Json?
  errorMessage String?
  createdAt    DateTime      @default(now())
  digests      DailyDigest[]

  @@index([purpose, createdAt])
}

model JobRun {
  id           String    @id @default(cuid())
  jobType      String
  sourceId     String?
  source       Source?   @relation(fields: [sourceId], references: [id], onDelete: SetNull)
  status       JobStatus @default(RUNNING)
  startedAt    DateTime  @default(now())
  finishedAt   DateTime?
  scannedCount Int       @default(0)
  createdCount Int       @default(0)
  skippedCount Int       @default(0)
  errorMessage String?
  metadata     Json?

  @@index([jobType, startedAt])
  @@index([sourceId, startedAt])
  @@index([status, startedAt])
}
